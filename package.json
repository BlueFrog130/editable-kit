{
	"name": "editable-kit-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"version": "0.3.0",
	"description": "Svelte 5 component library for inline editing — editable text, rich text (TipTap), and images with cropping",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"inline-editing",
		"contenteditable",
		"rich-text",
		"tiptap",
		"wysiwyg",
		"image-editor",
		"image-cropping",
		"component-library",
		"editable",
		"prosemirror"
	],
	"author": "BlueFrog130",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BlueFrog130/editable-kit.git"
	},
	"homepage": "https://github.com/BlueFrog130/editable-kit",
	"bugs": {
		"url": "https://github.com/BlueFrog130/editable-kit/issues"
	},
	"scripts": {
		"dev": "pnpm --filter editable-kit dev",
		"build": "pnpm -r build",
		"package": "pnpm --filter editable-kit package",
		"check": "pnpm -r check",
		"test": "pnpm --filter editable-kit test run",
		"lint": "oxlint && oxfmt --check",
		"format": "oxfmt",
		"changeset": "changeset",
		"release": "pnpm --filter editable-kit release"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"svelte": "^5.56.9",
		"tw-animate-css": "^1.4.0"
	}
}
