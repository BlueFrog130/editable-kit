{
	"name": "editable-kit",
	"version": "0.1.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./editable": {
			"types": "./dist/components/editable/index.d.ts",
			"svelte": "./dist/components/editable/index.js"
		},
		"./editors": {
			"types": "./dist/components/editors/index.d.ts",
			"svelte": "./dist/components/editors/index.js"
		},
		"./renderer": {
			"types": "./dist/components/renderer/index.d.ts",
			"svelte": "./dist/components/renderer/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.0.0-next.1"
	},
	"devDependencies": {
		"@floating-ui/dom": "^1.7.5",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.575.0",
		"@shikijs/langs": "^4.0.0",
		"@shikijs/themes": "^4.0.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.53.3",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.3.2",
		"bits-ui": "^2.16.2",
		"clsx": "^2.1.1",
		"jsdom": "^28.1.0",
		"lucide-svelte": "^0.575.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.17",
		"shiki": "^4.0.0",
		"svelte": "5.53.5",
		"svelte-check": "^4.4.4",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.1",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"@tiptap/core": "^3.20.0",
		"@tiptap/extension-blockquote": "^3.20.0",
		"@tiptap/extension-bold": "^3.20.0",
		"@tiptap/extension-bullet-list": "^3.20.0",
		"@tiptap/extension-document": "^3.20.0",
		"@tiptap/extension-dropcursor": "^3.20.0",
		"@tiptap/extension-gapcursor": "^3.20.0",
		"@tiptap/extension-hard-break": "^3.20.0",
		"@tiptap/extension-heading": "^3.20.0",
		"@tiptap/extension-history": "^3.20.0",
		"@tiptap/extension-image": "^3.20.0",
		"@tiptap/extension-italic": "^3.20.0",
		"@tiptap/extension-link": "^3.20.0",
		"@tiptap/extension-list-item": "^3.20.0",
		"@tiptap/extension-ordered-list": "^3.20.0",
		"@tiptap/extension-paragraph": "^3.20.0",
		"@tiptap/extension-placeholder": "^3.20.0",
		"@tiptap/extension-strike": "^3.20.0",
		"@tiptap/extension-text": "^3.20.0",
		"@tiptap/extension-underline": "^3.20.0",
		"@tiptap/pm": "^3.20.0"
	}
}
