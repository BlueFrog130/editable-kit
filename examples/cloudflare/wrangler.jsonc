{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "editable-kit-example",
	"compatibility_date": "2026-07-05",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	// Content JSON in D1, image bytes in R2.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "editable-kit",
			"database_id": "REPLACE_WITH_D1_ID",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "editable-kit-assets" }]
	// Secret (wrangler secret put / .dev.vars): ADMIN_TOKEN
}
